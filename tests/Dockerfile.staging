FROM python:3.12-slim
WORKDIR /srv/aak
COPY pyproject.toml ./
COPY aak ./aak
COPY tests/container_network_harness.py ./tests/container_network_harness.py
COPY tests/test_distributed.py ./tests/test_distributed.py
RUN pip install --no-cache-dir "cryptography>=42,<51" "psycopg[binary]>=3.2,<4"
ENV PYTHONPATH=/srv/aak:/srv/aak/tests
ENTRYPOINT ["python","tests/container_network_harness.py"]
